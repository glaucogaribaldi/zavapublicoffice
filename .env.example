# Ufficio Zava — example configuration

OFFICE_ENV=development
OFFICE_API_PORT=8088
OFFICE_DASHBOARD_PORT=3000

POSTGRES_DB=zavaoffice
POSTGRES_USER=zavaoffice
POSTGRES_PASSWORD=change_me
DATABASE_URL=postgresql://zavaoffice:change_me@postgres:5432/zavaoffice

# Local OpenAI-compatible LLM endpoint on VPS.
LLM_BASE_URL=http://llm-server:8080/v1
LLM_MODEL=
LLM_API_KEY=local

# Embeddings may be served by same or separate local provider.
EMBEDDINGS_BASE_URL=
EMBEDDINGS_MODEL=

# Source Vault. Verify actual Aruba protocol before production use.
ZAVA_SOURCE_URI=
ZAVA_SOURCE_USER=
ZAVA_SOURCE_PASSWORD=

# Writable TRE workspace.
TRE_WORKSPACE_URI=
TRE_WORKSPACE_USER=
TRE_WORKSPACE_PASSWORD=

# Tailscale/internal addressing where needed.
U50_HOST=
VPS_HOST=100.73.54.72

# Never put real secrets in git.
